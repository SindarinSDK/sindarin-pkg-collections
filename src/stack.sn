# Stack<T> — LIFO stack backed by a dynamic array

struct Stack<T> =>
    items: T[]
    count: int

    static fn new(): Stack<T> =>
        return Stack<T> { items: {}, count: 0 }

    fn push(item: T): void =>
        self.items.push(item)
        self.count = self.count + 1

    fn pop(): T =>
        self.count = self.count - 1
        return self.items.pop()

    fn peek(): T =>
        return self.items[self.count - 1]

    fn size(): int =>
        return self.count

    fn isEmpty(): bool =>
        return self.count == 0
