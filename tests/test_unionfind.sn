import "../src/unionfind"

fn main(): void =>
    var uf: UnionFind = newUnionFind(10)
    assert(uf.componentCount() == 10, "initial components")
    assert(!uf.connected(0, 1), "0 and 1 not connected initially")

    uf.union(0, 1)
    assert(uf.connected(0, 1), "0-1 connected after union")
    assert(uf.componentCount() == 9, "components after 1 union")

    uf.union(2, 3)
    uf.union(0, 3)
    assert(uf.connected(0, 2), "0-2 connected transitively")
    assert(uf.connected(1, 3), "1-3 connected transitively")
    assert(uf.componentCount() == 7, "components after 3 unions")

    assert(!uf.connected(0, 5), "0 and 5 not connected")
    println("test_unionfind_basic: PASS")

    # Idempotent union
    uf.union(0, 1)
    assert(uf.componentCount() == 7, "duplicate union no-op")
    println("test_unionfind_idempotent: PASS")

    # Large union-find
    var uf2: UnionFind = newUnionFind(1000)
    for i in 0..999 =>
        uf2.union(i, i + 1)
    assert(uf2.componentCount() == 1, "all connected")
    assert(uf2.connected(0, 999), "first and last connected")
    println("test_unionfind_large: PASS")
